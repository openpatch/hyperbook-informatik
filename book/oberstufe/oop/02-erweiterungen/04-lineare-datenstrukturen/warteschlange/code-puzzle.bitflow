  "nodes": [
    {
      "id": "enqueue",
      "type": "task-parsons",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "instruction": "Die Methode `enqueue` hängt ein Objekt hinten an die Schlange. Setze den Rumpf von `public void enqueue(T pContent) { ... }` zusammen. Eine Zeile gehört nicht dazu.",
        "language": "java",
        "lines": [
          {
            "id": "l1",
            "text": "QueueNode neuerKnoten = new QueueNode(pContent);",
            "indent": 0,
            "distractor": false
          },
          {
            "id": "l2",
            "text": "if (head == null) {",
            "indent": 0,
            "distractor": false
          },
          {
            "id": "l3",
            "text": "head = neuerKnoten;",
            "indent": 1,
            "distractor": false
          },
          {
            "id": "l4",
            "text": "} else {",
            "indent": 0,
            "distractor": false
          },
          {
            "id": "l5",
            "text": "tail.setNextNode(neuerKnoten);",
            "indent": 1,
            "distractor": false
          },
          {
            "id": "l6",
            "text": "}",
            "indent": 0,
            "distractor": false
          },
          {
            "id": "l7",
            "text": "tail = neuerKnoten;",
            "indent": 0,
            "distractor": false
          },
          {
            "id": "d1",
            "text": "neuerKnoten.setNextNode(head);",
            "indent": 0,
            "distractor": true
          }
        ],
        "indentationMatters": true,
        "penaliseDistractors": false,
        "evaluation": {
          "mode": "auto",
          "enableRetry": true,
          "showFeedback": true
        }
      }
    },
    {
      "id": "dequeue",
      "type": "task-parsons",
      "position": {
        "x": 0,
        "y": 120
      },
      "data": {
        "instruction": "Die Methode `dequeue` nimmt den ersten Knoten aus der Schlange. Setze den Rumpf von `public void dequeue() { ... }` zusammen. Eine Zeile gehört nicht dazu.",
        "language": "java",
        "lines": [
          {
            "id": "l1",
            "text": "if (head != null) {",
            "indent": 0,
            "distractor": false
          },
          {
            "id": "l2",
            "text": "head = head.getNextNode();",
            "indent": 1,
            "distractor": false
          },
          {
            "id": "l3",
            "text": "}",
            "indent": 0,
            "distractor": false
          },
          {
            "id": "d1",
            "text": "tail = tail.getNextNode();",
            "indent": 0,
            "distractor": true
          }
        ],
        "indentationMatters": true,
        "penaliseDistractors": false,
        "evaluation": {
          "mode": "auto",
          "enableRetry": true,
          "showFeedback": true
        }
      }
    },
    {
      "id": "leer",
      "type": "task-choice",
      "position": {
        "x": 0,
        "y": 240
      },
      "data": {
        "instruction": "Nach einem `dequeue` ist head null – die Schlange ist leer. Was muss dann zusätzlich geschehen?",
        "variant": "single",
        "choices": [
          {
            "id": "a",
            "markdown": "Nichts, head genügt.",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "tail zeigt dann noch auf den Knoten, den es nicht mehr gibt.",
              "severity": "warning"
            }
          },
          {
            "id": "b",
            "markdown": "`tail` muss ebenfalls auf `null` gesetzt werden.",
            "correct": true,
            "feedbackWhenChecked": {
              "message": "Genau. Sonst hängt das nächste enqueue am alten Knoten.",
              "severity": "success"
            }
          },
          {
            "id": "c",
            "markdown": "`tail` muss auf `head` gesetzt werden.",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "head ist null – damit wäre tail zwar auch null, aber nur zufällig richtig.",
              "severity": "warning"
            }
          }
        ],
        "shuffle": false,
        "partialCredit": false,
        "patternFeedback": [],
        "evaluation": {
          "mode": "auto",
          "enableRetry": true,
          "showFeedback": true
        }
      }
    },
    {
