        "code": "NRWQueue<String> q = new NRWQueue<String>();\nq.enqueue(\"A\");\nq.enqueue(\"B\");\nq.dequeue();\nq.enqueue(\"C\");",
        "showLineNumbers": true,
        "columns": [
