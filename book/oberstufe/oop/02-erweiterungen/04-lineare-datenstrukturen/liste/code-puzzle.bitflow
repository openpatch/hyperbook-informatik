        "x": 0,
        "y": 120
      },
      "data": {
        "instruction": "Die Methode `next` rückt current einen Knoten weiter – aber nur, wenn es ein aktuelles Objekt gibt. Setze den Rumpf von `public void next() { ... }` zusammen. Zwei Zeilen gehören nicht dazu.",
        "language": "java",
        "lines": [
          {
            "id": "l1",
            "text": "if (hasAccess()) {",
            "indent": 0,
            "distractor": false
          },
          {
            "id": "l2",
            "text": "current = current.getNextNode();",
            "indent": 1,
            "distractor": false
          },
          {
            "id": "l3",
            "text": "}",
            "indent": 0,
            "distractor": false
          },
          {
            "id": "d1",
            "text": "current = first;",
            "indent": 1,
            "distractor": true
          },
          {
