    {
      "id": "schleifen",
      "type": "task-parsons",
      "position": {
        "x": 0,
        "y": 1400
      },
      "data": {
        "instruction": "Ein Filter soll jeden Bildpunkt besuchen. Setze die geschachtelten Schleifen zusammen: außen die Zeilen, innen die Spalten.",
        "language": "java",
        "lines": [
          {
            "id": "aussen",
            "text": "for (int zeile = 0; zeile < bild.length; zeile++) {",
            "indent": 0,
            "distractor": false
          },
          {
            "id": "innen",
            "text": "for (int spalte = 0; spalte < bild[zeile].length; spalte++) {",
            "indent": 1,
            "distractor": false
          },
          {
            "id": "wert",
            "text": "bild[zeile][spalte] = bild[zeile][spalte] + 40;",
            "indent": 2,
            "distractor": false
          },
          {
            "id": "innen-zu",
            "text": "} // Ende der Spalten-Schleife",
            "indent": 1,
            "distractor": false
          },
          {
            "id": "aussen-zu",
            "text": "} // Ende der Zeilen-Schleife",
            "indent": 0,
            "distractor": false
          },
          {
            "id": "ablenkung",
            "text": "bild = bild + 40;",
            "indent": 1,
            "distractor": true
          }
        ],
        "indentationMatters": false,
        "penaliseDistractors": false,
        "evaluation": {
          "mode": "auto",
          "enableRetry": true,
          "showFeedback": true,
          "allowSkip": false
        }
      }
    },
    {
      "id": "ende",
      "type": "end-tries",
      "position": {
        "x": 0,
        "y": 1540
      },
      "data": {
        "title": "Bereit für das echte Foto",
        "markdown": "Du weißt jetzt: Ein Bild ist ein Feld von Zeilen, und jede Zeile ist ein Feld von Zahlen. Mit zwei geschachtelten Schleifen erreichst du jeden Bildpunkt. Unter der Startmission wendest du das auf das echte Foto an.",
        "showBreakdown": true,
        "showScore": true,
        "allowReview": true
      }
    }
