  "nodes": [
    {
      "id": "start",
      "type": "start-simple",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "title": "Startmission: Im Gitter zurechtfinden",
        "markdown": "Ein Foto ist ein Gitter aus Zahlen, und in Java ist dieses Gitter ein **Feld von Feldern**. In acht kurzen Stationen übst du, dich darin zurechtzufinden.",
        "showOutline": true
      }
    },
    {
      "id": "bildspeicher",
      "type": "task-choice",
      "position": {
        "x": 0,
        "y": 140
      },
      "data": {
        "instruction": "Ein Graustufenfoto liegt im Speicher. Welche Beschreibung passt?",
        "variant": "single",
        "choices": [
          {
            "id": "tabelle",
            "markdown": "Eine Tabelle enthält für jeden Bildpunkt eine Zahl von 0 bis 255.",
            "correct": true,
            "feedbackWhenChecked": {
              "message": "Genau: 0 steht für Schwarz, 255 für Weiß.",
              "severity": "success"
            }
          },
          {
            "id": "befehl",
            "markdown": "Das Foto besteht aus einem einzigen langen Java-Befehl.",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Java kann das Bild verarbeiten, aber die Bilddaten selbst sind Zahlen.",
              "severity": "warning"
            }
          },
          {
            "id": "zahl",
            "markdown": "Das ganze Foto wird durch eine einzige Helligkeitszahl gespeichert.",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Dann könnten verschiedene Stellen des Bildes nicht unterschiedlich hell sein.",
              "severity": "warning"
            }
          }
        ],
        "shuffle": false,
        "partialCredit": false,
        "patternFeedback": [],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      }
    },
    {
      "id": "hilfe-bildspeicher",
      "type": "title-simple",
      "position": {
        "x": 320,
        "y": 280
      },
      "data": {
        "title": "Ein Bild ist eine Zahlentabelle",
        "markdown": "Jeder Bildpunkt besitzt eine eigene Helligkeit. **0** bedeutet Schwarz, **255** bedeutet Weiß. Die Zeilen und Spalten des Bildes bilden deshalb eine Tabelle aus Zahlen. Klicke auf **Weiter**, um es noch einmal zu versuchen."
      }
    },
