    {
      "id": "helligkeit",
      "type": "task-choice",
      "position": {
        "x": 0,
        "y": 1120
      },
      "data": {
        "instruction": "Ein Filter addiert zu jedem Helligkeitswert 40. Werte über 255 werden auf 255 begrenzt. Was wird aus dem Wert 240?",
        "variant": "single",
        "choices": [
          {
            "id": "wert-240",
            "markdown": "240",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Dann hätte der Filter diesen Bildpunkt gar nicht verändert.",
              "severity": "warning"
            }
          },
          {
            "id": "wert-255",
            "markdown": "255",
            "correct": true,
            "feedbackWhenChecked": {
              "message": "Richtig: 240 + 40 ergibt zunächst 280 und wird dann auf 255 begrenzt.",
              "severity": "success"
            }
          },
          {
            "id": "wert-280",
            "markdown": "280",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Das ist das Zwischenergebnis. Ein Helligkeitswert darf aber nicht größer als 255 werden.",
              "severity": "warning"
            }
          }
        ],
        "shuffle": false,
        "partialCredit": false,
        "patternFeedback": [],
        "evaluation": {
          "mode": "auto",
          "enableRetry": true,
          "showFeedback": true,
          "allowSkip": false
        }
      }
    },
    {
      "id": "trace",
      "type": "task-code-trace",
      "position": {
        "x": 0,
        "y": 1260
      },
      "data": {
        "instruction": "Verfolge, wie der Bildpunkt mit dem Wert 240 aufgehellt wird. Trage jeweils den aktuellen Wert von `wert` ein.",
        "language": "java",
        "code": "int wert = bild[0][2];\nwert = wert + 40;\nif (wert > 255) {\n    wert = 255;\n}",
        "showLineNumbers": true,
        "columns": [
          {
            "id": "wert",
