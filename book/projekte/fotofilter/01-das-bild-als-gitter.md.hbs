## Dein erster Filter

Jetzt wendest du den Bauplan auf das echte Foto an. Starte das Programm zuerst
unverändert: Beide Bilder sehen gleich aus. Ergänze dann in der markierten Zeile
`+ pStufen` und starte es erneut.

:::onlineide{height="700px" speed="1000000"}
@file dest="fotofilter.png" src="/images/fotofilter.png"

```java Main.java
void main() {
    Foto foto = new Foto();
    int[][] grau = foto.graustufen();

    Leinwand leinwand = new Leinwand(2);
    leinwand.zeige(grau);
    leinwand.zeige(heller(grau, 60));
}

/** Liefert ein neues Bild, in dem jeder Wert um pStufen groesser ist. */
int[][] heller(int[][] pGrau, int pStufen) {
    int[][] neu = new int[pGrau.length][pGrau[0].length];

    for (int zeile = 0; zeile < pGrau.length; zeile++) {
        for (int spalte = 0; spalte < pGrau[zeile].length; spalte++) {
            int wert = pGrau[zeile][spalte]; // ergaenze hier: + pStufen
            if (wert > 255) {
                wert = 255;
            }
            neu[zeile][spalte] = wert;
        }
    }

    return neu;
}
```

