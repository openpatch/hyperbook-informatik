    IO.println("Mittlere Helligkeit: " + durchschnitt(grau));

    Leinwand leinwand = new Leinwand(1);
    leinwand.zeige(grau);
}

/** Liefert die mittlere Helligkeit aller Bildpunkte. */
int durchschnitt(int[][] pGrau) {
    return 0; // ersetze diese Zeile
}
