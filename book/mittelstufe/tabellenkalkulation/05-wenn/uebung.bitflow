    {
      "id": "und-oder",
      "type": "task-boolean-logic",
      "position": {
        "x": 0,
        "y": 700
      },
      "data": {
        "instruction": "Ergänze die Wahrheitstabelle für UND und ODER.",
        "variables": [
          "A",
          "B"
        ],
        "columns": [
          {
            "id": "und",
            "label": "UND(A; B)",
            "expression": {
              "kind": "and",
              "left": {
                "kind": "variable",
