      },
      "data": {
        "title": "Übung: Wachstum modellieren und simulieren",
        "markdown": "Acht Aufgaben zu linearem, exponentiellem und quadratischem Wachstum und zu Prognosen. Bei einem Fehler bekommst du einen Hinweis und einen zweiten Versuch.",
        "showOutline": false
      }
    },
    {
      "id": "modelle",
      "type": "task-matching",
      "position": {
        "x": 0,
        "y": 140
      },
      "data": {
        "instruction": "Ordne jeder Regel das Wachstumsmodell zu.",
        "pairs": [
          {
            "id": "p1",
            "left": {
              "kind": "text",
              "label": "Jeden Monat kommen 20 Kundinnen und Kunden hinzu."
            },
            "right": {
              "kind": "text",
              "label": "linear"
            }
          },
          {
            "id": "p2",
            "left": {
              "kind": "text",
              "label": "Jeden Monat wächst die Zahl um 8 %."
            },
            "right": {
              "kind": "text",
              "label": "exponentiell"
            }
          },
          {
            "id": "p3",
            "left": {
              "kind": "text",
              "label": "Die Zuwächse lauten +3, +5, +7, +9, …"
            },
            "right": {
              "kind": "text",
              "label": "quadratisch"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      }
    },
