    {
      "id": "formeln",
      "type": "task-fill-in-the-blank",
      "position": {
        "x": 0,
        "y": 560
      },
      "data": {
        "instruction": "Der feste Zuwachs steht in `F1`, die Wachstumsrate in `F2`. Ergänze die Formeln für `B3` (linear) und `C3` (exponentiell), die sich nach unten kopieren lassen.",
        "text": "B3: =B2+[[1]]    C3: =C2*(1+[[2]])",
        "blanks": {
          "1": [
            "$F$1"
          ],
          "2": [
            "$F$2"
          ]
        },
        "caseSensitive": false,
        "trim": true,
        "partialCredit": true,
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      }
    },
    {
      "id": "folge",
      "type": "task-choice",
      "position": {
        "x": 0,
        "y": 700
      },
      "data": {
        "instruction": "Eine Folge lautet 2, 6, 18, 54, … Welches Modell liegt vor?",
        "variant": "single",
        "choices": [
          {
            "id": "o1",
            "markdown": "exponentiell",
            "correct": true,
            "feedbackWhenChecked": {
              "message": "Richtig: Der Quotient aufeinanderfolgender Werte ist immer 3.",
              "severity": "success"
            }
          },
          {
            "id": "o2",
            "markdown": "linear",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Die Zuwächse (4, 12, 36) sind nicht gleich.",
              "severity": "warning"
            }
          },
          {
            "id": "o3",
            "markdown": "quadratisch",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Die Zuwächse wachsen nicht gleichmäßig, sie verdreifachen sich.",
              "severity": "warning"
            }
          }
        ],
        "shuffle": false,
