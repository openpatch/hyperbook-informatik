    {
      "id": "begruendung",
      "type": "task-matching",
      "position": {
        "x": 0,
        "y": 280
      },
      "data": {
        "instruction": "Begründe deine Wahl: Ordne jedem Diagrammtyp zu, wann er passt.",
        "pairs": [
          {
            "id": "p1",
            "left": {
              "kind": "text",
              "label": "Liniendiagramm"
            },
            "right": {
              "kind": "text",
              "label": "Die Werte folgen zeitlich aufeinander; der Verlauf soll sichtbar werden."
            }
          },
          {
            "id": "p2",
            "left": {
              "kind": "text",
              "label": "Säulendiagramm"
            },
            "right": {
              "kind": "text",
              "label": "Wenige Kategorien werden direkt miteinander verglichen."
            }
          },
          {
            "id": "p3",
            "left": {
              "kind": "text",
              "label": "XY-Punktdiagramm"
            },
            "right": {
              "kind": "text",
              "label": "Zu jedem Datensatz gibt es zwei Zahlen; gesucht ist, ob sie zusammenhängen."
            }
          },
          {
            "id": "p4",
            "left": {
              "kind": "text",
              "label": "Kreisdiagramm"
            },
            "right": {
              "kind": "text",
              "label": "Die Teile ergeben zusammen ein Ganzes, also 100 %."
            }
          }
        ],
        "evaluation": {
