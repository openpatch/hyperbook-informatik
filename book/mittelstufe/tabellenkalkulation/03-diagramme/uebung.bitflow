    {
      "id": "korrelation",
      "type": "task-choice",
      "position": {
        "x": 0,
        "y": 980
      },
      "data": {
        "instruction": "Das Diagramm zeigt: In größeren europäischen Städten gibt es mehr Fahrräder und mehr Verkehrsunfälle. Welche Aussage trägt das Diagramm wirklich?",
        "variant": "single",
        "choices": [
          {
            "id": "o1",
            "markdown": "In den betrachteten Städten treten viele Fahrräder und viele Unfälle gemeinsam auf.",
            "correct": true,
            "feedbackWhenChecked": {
              "message": "Richtig – das ist eine Beobachtung, keine Ursache.",
              "severity": "success"
            }
          },
          {
            "id": "o2",
            "markdown": "Fahrräder verursachen Verkehrsunfälle.",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Korrelation ist keine Ursache. Größere Städte haben einfach von allem mehr.",
              "severity": "warning"
            }
          },
          {
            "id": "o3",
            "markdown": "Weniger Fahrräder würden die Unfälle senken.",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Das ist eine Vermutung über eine Ursache, die das Diagramm nicht belegt.",
              "severity": "warning"
            }
          }
        ],
        "shuffle": false,
        "partialCredit": false,
        "patternFeedback": [],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "section": "fahrrad"
    },
    {
