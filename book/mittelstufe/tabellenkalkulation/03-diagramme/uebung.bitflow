      "position": {
        "x": 0,
        "y": 1120
      },
      "data": {
        "instruction": "Welche Größe macht den Unfallvergleich zwischen den Städten fairer?",
        "variant": "single",
        "choices": [
          {
            "id": "o1",
            "markdown": "Unfälle pro 100 000 Einwohner",
            "correct": true,
            "feedbackWhenChecked": {
              "message": "Genau – eine Bezugsgröße macht Städte vergleichbar.",
              "severity": "success"
            }
          },
          {
            "id": "o2",
            "markdown": "Unfälle insgesamt",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Absolute Zahlen sind in großen Städten fast immer größer.",
              "severity": "warning"
            }
          },
          {
            "id": "o3",
            "markdown": "Unfälle als 3D-Säulen",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Die Darstellung ändert nichts an der Vergleichsgröße.",
              "severity": "warning"
            }
          }
        ],
