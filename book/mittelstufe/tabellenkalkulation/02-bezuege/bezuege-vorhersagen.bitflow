  "nodes": [
    {
      "id": "start",
      "type": "start-simple",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "title": "Wohin wandern die Bezüge?",
        "markdown": "Sage vorher, was beim Kopieren aus einer Formel wird. Danach probierst du es in Calc aus. Bei einem Fehler bekommst du einen Hinweis und einen zweiten Versuch.",
        "showOutline": false
      }
    },
    {
      "id": "nach-unten",
      "type": "task-choice",
      "position": {
        "x": 0,
        "y": 140
      },
      "data": {
        "instruction": "In `C2` steht `=B2*$F$1`. Die Formel wird eine Zeile nach unten nach `C3` kopiert. Welche Formel steht dann in `C3`?",
        "variant": "single",
        "choices": [
          {
            "id": "o1",
            "markdown": "`=B3*$F$1`",
            "correct": true,
            "feedbackWhenChecked": {
              "message": "Richtig: Der Preis wandert mit, der Kurs bleibt fest.",
              "severity": "success"
            }
          },
          {
            "id": "o2",
            "markdown": "`=B3*$F$2`",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "`$F$1` ist absolut – Spalte und Zeile sind festgehalten.",
              "severity": "warning"
            }
          },
          {
            "id": "o3",
            "markdown": "`=B2*$F$1`",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "`B2` ist relativ und wandert eine Zeile mit.",
              "severity": "warning"
            }
          }
        ],
        "shuffle": false,
        "partialCredit": false,
        "patternFeedback": [],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      }
    },
    {
      "id": "nach-rechts",
      "type": "task-choice",
      "position": {
        "x": 0,
        "y": 280
      },
      "data": {
        "instruction": "Dieselbe Formel `=B2*$F$1` wird von `C2` eine Spalte nach **rechts** nach `D2` kopiert. Welche Formel steht dann in `D2`?",
        "variant": "single",
        "choices": [
          {
            "id": "o1",
            "markdown": "`=C2*$F$1`",
            "correct": true,
            "feedbackWhenChecked": {
              "message": "Genau: Nach rechts wandert der Spaltenbuchstabe, B wird zu C.",
              "severity": "success"
            }
          },
          {
            "id": "o2",
            "markdown": "`=B3*$F$1`",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Nach rechts ändert sich die Spalte, nicht die Zeile.",
              "severity": "warning"
            }
          },
          {
            "id": "o3",
            "markdown": "`=C2*$G$1`",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "`$F$1` bleibt auch beim Kopieren nach rechts fest.",
              "severity": "warning"
            }
          }
        ],
        "shuffle": false,
        "partialCredit": false,
        "patternFeedback": [],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      }
    },
    {
      "id": "vier-bezuege",
      "type": "task-table",
      "position": {
        "x": 0,
        "y": 420
      },
      "data": {
        "instruction": "In `C2` steht jeweils eine Formel mit dem angegebenen Bezug. Sie wird nach `D4` kopiert – eine Spalte nach rechts, zwei Zeilen nach unten. Trage ein, was dann in `D4` steht.",
        "caption": "",
        "columns": [
          {
            "id": "in c2",
            "header": "in C2",
            "kind": "formula"
          },
          {
            "id": "in d4",
            "header": "in D4",
            "kind": "formula"
          }
        ],
        "rows": [
          {
            "id": "z1",
            "header": "1",
            "cells": {
              "in c2": {
                "given": "=B2"
              },
              "in d4": {
                "accepted": [
                  "=C4"
                ]
              }
            }
          },
          {
            "id": "z2",
            "header": "2",
            "cells": {
              "in c2": {
                "given": "=$B$2"
              },
              "in d4": {
                "accepted": [
                  "=$B$2"
                ]
              }
            }
          },
          {
            "id": "z3",
            "header": "3",
            "cells": {
              "in c2": {
                "given": "=$B2"
              },
              "in d4": {
                "accepted": [
                  "=$B4"
                ]
              }
            }
          },
          {
            "id": "z4",
            "header": "4",
            "cells": {
              "in c2": {
                "given": "=B$2"
              },
              "in d4": {
                "accepted": [
                  "=C$2"
                ]
              }
            }
          }
        ],
        "rowHeaders": true,
        "rowOrder": "fixed",
        "caseSensitive": false,
