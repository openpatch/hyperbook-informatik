    {
      "id": "waehrung",
      "type": "task-choice",
      "position": {
        "x": 0,
        "y": 420
      },
      "data": {
        "instruction": "Mila baut einen Währungsrechner: Preise in Euro stehen in `B2:B4`, der Kurs für Złoty in `F1`. Welche Formel gehört in `C2`, damit sie sich nach unten kopieren lässt?",
        "variant": "single",
        "choices": [
          {
            "id": "o1",
            "markdown": "`=B2*$F$1`",
            "correct": true,
            "feedbackWhenChecked": {
              "message": "Genau: Der Preis wandert, der Kurs bleibt fest.",
              "severity": "success"
            }
          },
          {
            "id": "o2",
            "markdown": "`=B2*F1`",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Beim Kopieren würde F1 zu F2 und F3 wandern.",
              "severity": "warning"
            }
          },
          {
            "id": "o3",
            "markdown": "`=$B$2*$F$1`",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Dann rechnet jede Zeile mit dem ersten Preis.",
              "severity": "warning"
            }
          }
        ],
        "shuffle": false,
        "partialCredit": false,
        "patternFeedback": [],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      }
    },
    {
      "id": "fehler-null",
      "type": "task-choice",
      "position": {
        "x": 0,
        "y": 560
      },
      "data": {
        "instruction": "Mila hat `=B2*F1` aus `C2` nach unten kopiert. In `C3` und `C4` erscheint `0`. Warum?",
        "variant": "single",
        "choices": [
          {
            "id": "o1",
            "markdown": "Die Formeln verweisen auf `F2` und `F3` – dort steht kein Kurs.",
            "correct": true,
            "feedbackWhenChecked": {
              "message": "Richtig. Eine leere Zelle zählt als 0.",
              "severity": "success"
            }
          },
          {
            "id": "o2",
            "markdown": "Calc kann Formeln nicht nach unten kopieren.",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Doch – das Ausfüllkästchen ist genau dafür da.",
              "severity": "warning"
            }
          },
          {
            "id": "o3",
            "markdown": "Die Preise in `B3` und `B4` sind zu klein.",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Auch ein kleiner Preis mal Kurs ergibt nicht 0.",
              "severity": "warning"
            }
          }
        ],
        "shuffle": false,
        "partialCredit": false,
        "patternFeedback": [],
