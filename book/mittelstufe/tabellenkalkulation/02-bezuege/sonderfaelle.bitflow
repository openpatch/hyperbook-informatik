      "data": {
        "title": "Geschafft",
        "markdown": "Du kannst mit Sonderfällen vorhersagen, was eine Formel liefern muss, und Fehler gezielt eingrenzen. Prüfe deine Vorhersagen jetzt in Calc.",
        "showBreakdown": true,
        "showScore": true,
        "allowReview": true
      }
